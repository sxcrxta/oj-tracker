{
  "manifest_version": 3,
  "name": "OJ 제출 기록기",
  "version": "0.1.0",
  "description": "dshs.app 온라인 저지에 제출한 코드와 채점 결과를 자동으로 저장합니다.",
  "permissions": ["storage", "alarms"],
  "host_permissions": [
    "https://dshs.app/*",
    "https://uciyqapuzugedebycbmz.supabase.co/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://dshs.app/*"],
      "js": ["adapters/dshs.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "OJ 제출 기록기"
  }
}
